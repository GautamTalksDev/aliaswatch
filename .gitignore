__pycache__/
*.pyc
*.egg-info/
build/
.venv/
node_modules/

# Build output. dist/ is committed by the daily job on the deploy branch, but
# never from a developer machine - a hand-built site is not a record.
dist/demo/

# Never commit the signing seed. The public key IS committed.
*.seed
signing-key
.env

# Local and mock runs. Never committed: a public record whose days were
# generated on a laptop is worth nothing, so the separation is enforced here
# as well as in code.
results-local/
dist/local/

# Build output. Cloudflare Pages builds this; it is not committed.
dist/
